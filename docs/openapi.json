{
  "openapi": "3.1.0",
  "info": {"title": "UniPass browser and resource API", "version": "0.1.0", "description": "Implemented business endpoints only. OAuth/OIDC endpoints are described by discovery. Browser POST requests require a session cookie and X-CSRF-TOKEN. Unauthenticated browser requests may redirect to /login."},
  "security": [{"sessionCookie": []}],
  "paths": {
    "/api/session/me": {"get": {"operationId": "sessionIdentity", "responses": {"200": {"description": "Current identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Identity"}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/session/csrf": {"get": {"operationId": "csrfToken", "responses": {"200": {"description": "CSRF header and token for this browser session", "content": {"application/json": {"schema": {"type": "object", "required": ["header_name", "parameter_name", "token"], "properties": {"header_name": {"type": "string"}, "parameter_name": {"type": "string"}, "token": {"type": "string"}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/password/change": {"post": {
      "operationId": "changeOwnPassword",
      "description": "Recent password authentication is required. Enrolled users and administrators also require recent MFA. Unknown directory results remain fenced and return 202.",
      "parameters": [{"$ref": "#/components/parameters/Csrf"}, {"in": "header", "name": "Idempotency-Key", "required": true, "schema": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{16,128}$"}}],
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["old_password", "new_password", "confirm_password"], "properties": {"old_password": {"$ref": "#/components/schemas/Password"}, "new_password": {"$ref": "#/components/schemas/Password"}, "confirm_password": {"$ref": "#/components/schemas/Password"}}}}}},
      "responses": {"200": {"$ref": "#/components/responses/PasswordOperation"}, "202": {"$ref": "#/components/responses/PasswordOperation"}, "default": {"$ref": "#/components/responses/Rejected"}}
    }},
    "/api/password/operations/{id}": {"get": {"operationId": "ownPasswordOperation", "parameters": [{"in": "path", "name": "id", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"$ref": "#/components/responses/PasswordOperation"}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/resource/me": {"get": {"operationId": "resourceIdentity", "security": [{"accessBearer": []}], "description": "Requires at+jwt, audience unipass-api, scope api.read and live account epoch/gate/family validation. ID tokens are rejected.", "responses": {"200": {"description": "Bearer identity", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Identity"}, {"type": "object", "required": ["client_id"], "properties": {"client_id": {"type": "string"}}}]}}}}, "401": {"$ref": "#/components/responses/Rejected"}, "403": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/mfa": {"get": {"operationId": "mfaStatus", "responses": {"200": {"description": "Factor status only", "content": {"application/json": {"schema": {"type": "object", "required": ["enrolled", "required", "recent"], "properties": {"enrolled": {"type": "boolean"}, "required": {"type": "boolean"}, "recent": {"type": "boolean"}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/mfa/enrollment": {"post": {"operationId": "startTotpEnrollment", "parameters": [{"$ref": "#/components/parameters/Csrf"}], "responses": {"200": {"description": "Sensitive, one-time display. Confirmation expires after five minutes.", "content": {"application/json": {"schema": {"type": "object", "required": ["secret", "otpauthUri", "expiresAt"], "properties": {"secret": {"type": "string", "description": "Base32 TOTP secret; never log or persist in the browser"}, "otpauthUri": {"type": "string", "format": "uri"}, "expiresAt": {"type": "string", "format": "date-time"}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/mfa/enrollment/confirm": {"post": {"operationId": "confirmTotpEnrollment", "parameters": [{"$ref": "#/components/parameters/Csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["code"], "properties": {"code": {"$ref": "#/components/schemas/Otp"}}}}}}, "responses": {"200": {"description": "Factor enabled and auth_epoch incremented; password reauthentication required", "content": {"application/json": {"schema": {"type": "object", "required": ["reauthentication_required"], "properties": {"reauthentication_required": {"type": "boolean", "const": true}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/mfa/context": {"post": {"operationId": "stepUpContext", "parameters": [{"$ref": "#/components/parameters/Csrf"}], "responses": {"200": {"description": "Session-owned step-up context", "content": {"application/json": {"schema": {"type": "object", "required": ["context"], "properties": {"context": {"type": "string", "format": "uuid"}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/mfa/challenges": {"post": {"operationId": "createMfaChallenge", "parameters": [{"$ref": "#/components/parameters/Csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["context"], "properties": {"context": {"type": "string", "format": "uuid"}}}}}}, "responses": {"200": {"description": "New five-minute challenge; supersedes previous challenge for this session", "content": {"application/json": {"schema": {"type": "object", "required": ["challenge"], "properties": {"challenge": {"type": "string", "format": "uuid"}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}},
    "/api/mfa/verify": {"post": {"operationId": "verifyMfaChallenge", "parameters": [{"$ref": "#/components/parameters/Csrf"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["context", "challenge", "code"], "properties": {"context": {"type": "string", "format": "uuid"}, "challenge": {"type": "string", "format": "uuid"}, "code": {"$ref": "#/components/schemas/Otp"}}}}}}, "responses": {"200": {"description": "Challenge and time step consumed; browser session ID rotated", "content": {"application/json": {"schema": {"type": "object", "required": ["verified"], "properties": {"verified": {"type": "boolean", "const": true}}}}}}, "default": {"$ref": "#/components/responses/Rejected"}}}}
  },
  "components": {
    "securitySchemes": {"sessionCookie": {"type": "apiKey", "in": "cookie", "name": "UNIPASS_SSO"}, "accessBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "parameters": {"Csrf": {"in": "header", "name": "X-CSRF-TOKEN", "required": true, "schema": {"type": "string"}, "description": "Use header_name and token returned by /api/session/csrf"}},
    "responses": {
      "Rejected": {"description": "Rejected request. Browser authentication can return 302 /login, epoch rejection 401, CSRF/MFA denial 403, validation 400, ownership 404, conflicts 409, limits 429 or unavailable state 503. Security filters may return an empty body; business errors include error and trace_id."},
      "PasswordOperation": {"description": "Non-secret operation status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PasswordOperation"}}}}
    },
    "schemas": {
      "Identity": {"type": "object", "required": ["sub", "auth_epoch"], "properties": {"sub": {"type": "string", "format": "uuid"}, "auth_epoch": {"type": "integer", "format": "int64"}}},
      "Password": {"type": "string", "writeOnly": true, "minLength": 1, "maxLength": 1024, "description": "Further Unicode complexity and directory policy validation applies"},
      "Otp": {"type": "string", "writeOnly": true, "pattern": "^[0-9]{6}$"},
      "PasswordOperation": {"type": "object", "required": ["id", "userId", "state", "fencedEpoch", "createdAt"], "properties": {"id": {"type": "string", "format": "uuid"}, "userId": {"type": "string", "format": "uuid"}, "state": {"type": "string", "enum": ["PREPARED", "COMMITTED", "REJECTED", "UNKNOWN"]}, "fencedEpoch": {"type": "integer", "format": "int64"}, "createdAt": {"type": "string", "format": "date-time"}, "finishedAt": {"type": ["string", "null"], "format": "date-time"}, "errorCode": {"type": ["string", "null"]}}}
    }
  }
}
